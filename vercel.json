{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/callback", "destination": "/api/webhook" },
    { "source": "/api/callback-qris", "destination": "/api/webhook" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
